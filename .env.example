# InsightLab local model configuration.
# Copy this file to .env, then fill in the Tencent Cloud Token Plan key.
TOKENHUB_API_KEY=
TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com/plan/v3

# Hermes model routing.
OPENATLAS_DEFAULT_MODEL=auto
OPENATLAS_DEFAULT_PROVIDER=tencent-token-plan
OPENATLAS_DEFAULT_PROVIDER_BASE_URL=https://tokenhub.tencentmaas.com/plan/v3
OPENATLAS_DEFAULT_PROVIDER_KEY_ENV=TOKENHUB_API_KEY
OPENATLAS_FALLBACK_MODEL=deepseek-v4-flash
