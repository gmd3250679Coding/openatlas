# OpenAtlas production environment template.
# Copy to /etc/openatlas/openatlas.env on the server and fill secrets.

OPENATLAS_ENV=production
OPENATLAS_PROJECT_ROOT=/opt/openatlas/current
OPENATLAS_HOME=/var/lib/openatlas
OPENATLAS_TENANT=demo
OPENATLAS_HERMES_AGENT_ROOT=/var/lib/openatlas/hermes-runtime

# FastAPI auth. Replace before exposing the service.
OPENATLAS_SECRET=change-me-generate-with-openssl-rand-hex-32
OPENATLAS_CORS_ORIGINS=

# Demo tenant Hermes gateway. This key is internal between OpenAtlas backend and
# the local tenant gateway; keep it server-side only.
HERMES_BASE_URL=http://127.0.0.1:58642
API_SERVER_KEY=change-me-openatlas-gateway-key

# Initial Hermes model config written only when a tenant .hermes/config.yaml is
# first created. Existing tenant config files are preserved.
OPENATLAS_DEFAULT_MODEL=mimo-v2.5-pro
OPENATLAS_DEFAULT_PROVIDER=custom:xiaomimimo
OPENATLAS_DEFAULT_PROVIDER_BASE_URL=https://api.xiaomimimo.com/v1
OPENATLAS_DEFAULT_PROVIDER_API_KEY=change-me-xiaomimimo-api-key
OPENATLAS_FALLBACK_MODEL=deepseek-v4-flash
OPENATLAS_FALLBACK_PROVIDER=custom:deepseek
OPENATLAS_FALLBACK_PROVIDER_BASE_URL=https://api.deepseek.com
OPENATLAS_FALLBACK_PROVIDER_API_KEY=change-me-deepseek-api-key

# Scenario agents.
OPENATLAS_OFFICIAL_WRITING_AGENT_ENABLED=1
OPENATLAS_OFFICIAL_WRITING_AGENT_TIMEOUT_SECONDS=28
OPENATLAS_PRESENTATION_AGENT_ENABLED=1
OPENATLAS_PRESENTATION_AGENT_TIMEOUT_SECONDS=110

# Long task behavior.
OPENATLAS_RUN_EVENT_IDLE_TIMEOUT_SECONDS=60
OPENATLAS_RUN_EVENT_DETACH_AFTER_SECONDS=900
OPENATLAS_RUN_RECONCILE_ATTEMPTS=60
OPENATLAS_RUN_RECONCILE_INTERVAL_SECONDS=10
OPENATLAS_MAX_ACTIVE_RUNS_PER_TENANT=6
OPENATLAS_MAX_ACTIVE_RUNS_PER_USER=2
OPENATLAS_QUOTA_RETRY_AFTER_SECONDS=90

# File/workspace limits.
OPENATLAS_FILE_TTL_DAYS=30
OPENATLAS_PREVIEW_TEXT_BYTES=1048576
OPENATLAS_WORKSPACE_MAX_LIST=500
